{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Endpoint Lab",
  "version": "0.1.0",
  "identifier": "com.matthewspeiser.endpoint-lab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Endpoint Lab",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Matthew Speiser",
    "homepage": "https://github.com/mrspeiser/endpoint-lab",
    "shortDescription": "A modern HTTP client and API benchmark tool",
    "longDescription": "Endpoint Lab is a Rust-first HTTP client and benchmark tool. Organize your API requests by domain, manage collections, and test endpoints with a beautiful, performant desktop interface."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/mrspeiser/endpoint-lab/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "GENERATE_WITH_TAURI_UPDATER"
    }
  }
}
